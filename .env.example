# Copy to .env and change secrets before exposing Mockie beyond a trusted LAN.
MOCKIE_HOST=mockie.home.arpa
MOCKIE_PORT=443
MOCKIE_BIND_IP=192.168.1.50
MOCKIE_MODE=offline
COMPOSE_PROFILES=
MOCKIE_MODEL=chatgpt/gpt-5.4
MOCKIE_SESSION_MINUTES=45
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=
DATABASE_PATH=/data/mockie.db
RUNNER_QUEUE_PATH=/queue
RUNNER_TIMEOUT_MS=4000
RUNNER_MAX_OUTPUT_BYTES=65536
