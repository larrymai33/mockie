{
  "name": "mockie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run build -w @mockie/core && npm run build -w @mockie/web && npm run build -w @mockie/server && npm run build -w @mockie/runner",
    "dev": "npm-run-all --parallel dev:server dev:web dev:runner",
    "dev:server": "npm run dev -w @mockie/server",
    "dev:web": "npm run dev -w @mockie/web",
    "dev:runner": "npm run dev -w @mockie/runner",
    "test": "npm run test --workspaces --if-present && vitest run tests",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run test && npm run typecheck && npm run build",
    "start": "npm run start -w @mockie/server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
